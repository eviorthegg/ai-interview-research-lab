# Evior Interview Research Lab — environment configuration (no secrets here)

# Provider ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_INTERVIEW_MODEL=gpt-5.6
OPENAI_EVALUATOR_MODEL=gpt-5.6
OPENAI_LOW_COST_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# "openai" for real calls, "stub" for the deterministic local stub (tests/demo).
# Model availability is validated at startup; unavailable models fail with a
# setup error instead of being silently replaced.
PROVIDER_MODE=stub

# Storage -------------------------------------------------------------------
DATABASE_URL=sqlite:///evior_research_lab.db

# Isolation (the app refuses to start experiments otherwise) ------------------
RESEARCH_LAB_MODE=true
ALLOW_PRODUCTION_WRITES=false

# Budget ---------------------------------------------------------------------
DEFAULT_PROJECT_BUDGET_USD=100
FINAL_VALIDATION_RESERVE_USD=20

# Execution ------------------------------------------------------------------
MAX_CONCURRENT_EXPERIMENTS=1
MAX_MODEL_RETRIES=2
SSE_HEARTBEAT_SECONDS=15
WORKER_HEARTBEAT_SECONDS=10
JOB_ABANDON_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Autonomous-loop safety limits ------------------------------------------------
MAX_AUTONOMOUS_ROUNDS=3
MAX_VARIANTS_PER_ROUND=2
MAX_AUTONOMOUS_EXPERIMENTS=12

# Read-only production artifact paths (defaults resolve inside this repo) ------
# EVIOR_PROMPTS_V3_PATH=
# EVIOR_INTRO_OUTRO_PATH=

# Web research for pipeline stages -------------------------------------------
# "stub" (labeled placeholder, free) or "openai" (real web search via the
# OpenAI Responses API web_search tool). Defaults to PROVIDER_MODE.
WEB_RESEARCH_MODE=stub
